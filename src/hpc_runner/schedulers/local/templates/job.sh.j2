#!/bin/bash
# Generated by hpc-runner (local scheduler)

# Exit on error
set -e

_hpc_on_exit() {
    local _ec=$?
    if [ -n "${_hpc_modlog:-}" ]; then rm -f "$_hpc_modlog"; fi
    return "$_ec"
}
trap _hpc_on_exit EXIT

{% include "_environment.sh.j2" %}
{% if stdout and not stderr %}

# Redirect stdout and stderr (merged) to file
exec > {{ stdout | sh }} 2>&1
{% elif stdout %}

# Redirect stdout and stderr to separate files
exec > {{ stdout | sh }} 2> {{ stderr | sh }}
{% endif %}

# Execute command
{{ job.command }}
exit $?
