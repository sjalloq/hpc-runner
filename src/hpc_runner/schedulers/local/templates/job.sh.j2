#!/bin/bash
# Generated by hpc-runner (local scheduler)

# Exit on error
set -e

_hpc_on_exit() {
    local _ec=$?
    if [ -n "${_hpc_modlog:-}" ]; then rm -f "$_hpc_modlog"; fi
    return "$_ec"
}
trap _hpc_on_exit EXIT

{% include "_environment.sh.j2" %}
{% if stdout_path and merge_output %}

# Redirect stdout and stderr to file
exec > {{ stdout_path | sh }} 2>&1
{% elif stdout_path %}

# Redirect stdout to file
exec > {{ stdout_path | sh }}
{% endif %}
{% if stderr_path and not merge_output %}

# Redirect stderr to file
exec 2> {{ stderr_path | sh }}
{% endif %}

# Execute command
{{ job.command }}
exit $?
