#!/bin/bash
# Generated by hpc-runner (Slurm scheduler)

{% for directive in directives %}
{{ directive }}
{% endfor %}

# Exit on error
set -e

_hpc_on_exit() {
    local _ec=$?
    if [ -n "${_hpc_modlog:-}" ]; then rm -f "$_hpc_modlog"; fi
    return "$_ec"
}
trap _hpc_on_exit EXIT

{% include "_environment.sh.j2" %}

# For srun inside the command: the job's CPU count and the environment above
export SRUN_CPUS_PER_TASK=$SLURM_CPUS_PER_TASK
export SLURM_EXPORT_ENV=ALL

# Execute command
{{ command }}
exit $?
