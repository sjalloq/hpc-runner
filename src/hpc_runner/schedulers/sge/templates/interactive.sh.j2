#!/bin/bash
# Generated by hpc-runner (SGE interactive job)

# Exit on error
set -e

_hpc_on_exit() {
    local _ec=$?
    if [ -n "${_hpc_modlog:-}" ]; then rm -f "$_hpc_modlog"; fi
    return "$_ec"
}
trap _hpc_on_exit EXIT

{% include "_environment.sh.j2" %}

# Execute command
{{ job.command }}
_exit_code=$?

{% if not keep_script %}
# Cleanup temporary script
rm -f {{ script_path | sh }}
{% endif %}

exit $_exit_code
