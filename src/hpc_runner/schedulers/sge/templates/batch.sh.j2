#!/bin/bash
# Generated by hpc-runner (SGE scheduler)

{% for directive in directives %}
{{ directive }}
{% endfor %}
{% for name, value in job.env_passthrough.items() %}
#$ -v {{ name }}={{ value | sh }}
{% endfor %}

# Exit on error
set -e

{% set publish_rc = scheduler.enforce_afterok and scheduler.exit_dir %}
{% if publish_rc %}
# --- hpc-runner afterok: publish this job's exit code (NFS-safe) ---
# SGE -hold_jid is afterany, so dependents read these sentinels to emulate
# afterok. The EXIT trap fires on success, `set -e` failure, and the guard
# below, so the exit code is always published. Write-then-rename is atomic
# on NFS so a reader never sees a partial value.
_hpc_exit_dir={{ scheduler.exit_dir | sh }}
mkdir -p "$_hpc_exit_dir"
{% endif %}
_hpc_on_exit() {
    local _ec=$?
{% if publish_rc %}
    { printf '%s\n' "$_ec" > "$_hpc_exit_dir/.${JOB_ID}.rc.$$" \
        && mv -f "$_hpc_exit_dir/.${JOB_ID}.rc.$$" "$_hpc_exit_dir/${JOB_ID}.rc" ; } 2>/dev/null || true
{% endif %}
    if [ -n "${_hpc_modlog:-}" ]; then rm -f "$_hpc_modlog"; fi
    return "$_ec"
}
trap _hpc_on_exit EXIT

{% include "_environment.sh.j2" %}

{% if publish_rc and afterok_ids %}
# --- hpc-runner afterok guard: abort unless all dependencies succeeded ---
# -hold_jid guarantees parents have exited (and flushed their sentinels), but
# allow a short bounded wait for the NFS directory-entry cache to refresh.
for _dep in {% for d in afterok_ids %}{{ d | sh }} {% endfor %}; do
    _rc=""
    for _try in $(seq 1 15); do
        if [ -f "$_hpc_exit_dir/${_dep}.rc" ]; then
            _rc="$(cat "$_hpc_exit_dir/${_dep}.rc" 2>/dev/null)"
            [ -n "$_rc" ] && break
        fi
        sleep 1
    done
    if [ "$_rc" != "0" ]; then
        echo "hpc-runner: afterok dependency ${_dep} did not succeed (rc='${_rc:-missing}'); aborting" >&2
        exit 1
    fi
done

{% endif %}
# Execute command
{{ job.command }}
_exit_code=$?

{% if script_path and not keep_script %}
# Cleanup temporary script
rm -f {{ script_path | sh }}
{% endif %}

exit $_exit_code
